<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <TieredPGO>true</TieredPGO>
    <EnableDynamicPGO>true</EnableDynamicPGO>
    <Optimize>true</Optimize>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Zoomies</RootNamespace>
    <AssemblyName>zoomies</AssemblyName>
    <Version>4.1</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\nnue\best.nnue" Condition="Exists('..\nnue\best.nnue')"
             CopyToOutputDirectory="Always" TargetPath="best.nnue" Link="best.nnue" />
  </ItemGroup>

</Project>
